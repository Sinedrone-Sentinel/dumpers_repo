<Application x:Class="BpDumperGui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             Exit="OnExit">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="#334155"/>
    <SolidColorBrush x:Key="FgBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>
  </Application.Resources>
</Application>
