<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    IgnorableNamespaces="uap uap10">
  <!--
    Partner Center identity (existing listing):
    Store ID 9PMR8CPSB04K
    Package Family Name SinedroneSentinel.BPDumper_fvbh2q0x73pq6
    AppContainer only. User picks LIVE via folder dialog.
  -->
  <Identity
    Name="SinedroneSentinel.BPDumper"
    Publisher="CN=BB0EF4E0-83D8-4581-AB1E-92981A9DA66B"
    Version="1.21.0.0" />
  <mp:PhoneIdentity PhoneProductId="8f4a1c2e-9b70-4d33-a6e1-3c8f9d12e4a7" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>BP Dumper</DisplayName>
    <PublisherDisplayName>Sinedrone Sentinel</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application
        Id="App"
        Executable="BPDumperGUI.exe"
        EntryPoint="Windows.PartialTrustApplication"
        uap10:TrustLevel="appContainer"
        uap10:RuntimeBehavior="packagedClassicApp">
      <uap:VisualElements
          DisplayName="BP Dumper"
          Description="Star Citizen blueprint log watcher for Dumper's Repo. You choose your LIVE folder; the app does not scan your drives."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
