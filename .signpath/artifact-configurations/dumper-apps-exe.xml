<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for DumperApps.exe (PE).
  Slug in SignPath UI must match workflow: dumper-apps-exe
  See docs/TRUST_AND_SIGNING.md and docs/CODE_SIGNING_POLICY.md
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file
    path="DumperApps.exe"
    product-name="Dumper Apps"
    product-version="${version}"
    original-filename="DumperApps.exe"
  >
    <authenticode-sign />
  </pe-file>
</artifact-configuration>
